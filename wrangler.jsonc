{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "investment-journal-demo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}
