{
  "name": "investment-journal-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:market-data": "node --experimental-strip-types tests/market-data.test.mjs",
    "test:calendar": "node --experimental-strip-types tests/financial-calendar.test.mjs",
    "test:telegram": "node --experimental-strip-types tests/telegram-transaction.test.mjs",
    "test:storage": "node --experimental-strip-types --test tests/offline-queue.test.mjs tests/portfolio-state-codec.test.mjs tests/verify-backup-restore.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "6.2.10",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "json-rpc-2.0": "1.7.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "raw-body": "3.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
