{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "test:market-data": "node --experimental-strip-types tests/market-data.test.mjs",
    "test:calendar": "node --experimental-strip-types tests/financial-calendar.test.mjs",
    "test:telegram": "node --experimental-strip-types tests/telegram-transaction.test.mjs",
    "test:storage": "node --experimental-strip-types --test tests/offline-queue.test.mjs tests/portfolio-state-codec.test.mjs tests/verify-backup-restore.test.mjs",
    "backup:json": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/backup-d1.ps1 -Mode Json",
    "backup:sql": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/backup-d1.ps1 -Mode Sql",
    "backup:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/backup-d1.ps1 -Mode All",
    "backup:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/install-backup-runtime.ps1",
    "backup:token": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/save-backup-token.ps1",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/test-backup-restore.ps1 -Force",
    "backup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/install-backup-tasks.ps1",
    "monitor:secret": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/save-monitor-secret.ps1",
    "monitor:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/monitor-health.ps1 -DryRun",
    "monitor:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/monitor-health.ps1",
    "monitor:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/install-monitor-task.ps1",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "6.2.10",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
